{
    "manifest_version": 3,
    "name": "Lead Harvester",
    "version": "0.1.0",
    "description": "Skuplja e-mail adrese, imena i Instagram profile sa Google rezultata i sa bilo koje stranice. Izvoz u CSV jednim klikom.",
    "permissions": ["storage", "activeTab", "scripting"],
    "host_permissions": ["http://*/*", "https://*/*"],
    "background": {
        "service_worker": "background.js",
        "type": "module"
    },
    "action": {
        "default_popup": "popup.html",
        "default_title": "Lead Harvester"
    },
    "content_scripts": [
        {
            "matches": [
                "*://www.google.com/search*",
                "*://www.google.rs/search*",
                "*://www.google.co.uk/search*",
                "*://www.google.de/search*",
                "*://www.google.hr/search*",
                "*://www.google.ba/search*",
                "*://www.google.me/search*",
                "*://www.google.mk/search*",
                "*://www.bing.com/search*",
                "*://duckduckgo.com/*"
            ],
            "js": ["content-serp.js"],
            "run_at": "document_idle"
        }
    ]
}
