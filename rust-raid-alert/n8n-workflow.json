{
  "name": "Rust Raid Alert",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "rust-raid",
        "responseMode": "onReceived",
        "responseData": "noData",
        "options": {}
      },
      "id": "a1b2c3d4-0001-4000-8000-000000000001",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [360, 300],
      "webhookId": "rust-raid-alert"
    },
    {
      "parameters": {
        "chatId": "={{ $env.TELEGRAM_CHAT_ID }}",
        "text": "=🚨 *RAID ALERT — RUST* 🚨\n\n*{{ $json.body.title || 'Alarm' }}*\n{{ $json.body.message }}\n\n🖥️ Server: {{ $json.body.server || 'n/a' }}\n🌐 {{ $json.body.ip }}:{{ $json.body.port }}\n🕐 {{ $json.body.timeLocal }}\n\n⚠️ Neko ti dira bazu — trci!",
        "additionalFields": {
          "parse_mode": "Markdown",
          "disable_notification": false
        }
      },
      "id": "a1b2c3d4-0002-4000-8000-000000000002",
      "name": "Telegram",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [640, 300],
      "credentials": {
        "telegramApi": {
          "id": "REPLACE_WITH_YOUR_TELEGRAM_CREDENTIAL_ID",
          "name": "Rust Raid Bot"
        }
      }
    }
  ],
  "connections": {
    "Webhook": {
      "main": [
        [
          {
            "node": "Telegram",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "active": false
}
