# Kopiraj ovaj fajl u `.env` i popuni vrednosti:
#   cp .env.example .env

# Webhook URL iz n8n Webhook node-a (Production URL).
# Primer: https://tvoj-n8n.example.com/webhook/rust-raid
N8N_WEBHOOK_URL=

# Prosledjuj samo Smart Alarm notifikacije (true) ili sve FCM poruke (false).
# Ostavi true za normalnu upotrebu.
ALARM_ONLY=true

# (opciono) putanja do rustplus.config.json ako nije u ovom folderu
# RUSTPLUS_CONFIG=./rustplus.config.json

# (opciono) vremenska zona za lokalni prikaz vremena
TZ=Europe/Belgrade
